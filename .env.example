# ─── Jobkar website environment template ───
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets never enter the repo.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google AdSense (optional until the account is approved). Set the publisher
# id to light up every ad slot; leave unset and the site renders clean with
# no ads and no AdSense script.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
