# ─── Jobkar environment template ───
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets never enter the repo.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

CRON_SECRET=change-me-to-a-long-random-string

# true = local dashboard app (you + friend's machines)
# false = public website (set this in Vercel production env)
ENABLE_DASHBOARDS=false
