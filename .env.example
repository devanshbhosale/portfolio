# ─── Jobkar website environment template ───
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets never enter the repo.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Dodo Payments (merchant-of-record) — sign up at https://app.dodopayments.com/signup
# API key: Dashboard → Developers → API Keys (test keys start with dodo_test_)
DODO_PAYMENTS_API_KEY=your-dodo-api-key
# Webhook signing secret: Dashboard → Developer → Webhooks → your endpoint → Overview (starts with whsec_)
DODO_PAYMENTS_WEBHOOK_KEY=your-dodo-webhook-signing-secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Plan → Dodo product id map (create one product per plan in the dashboard):
DODO_PRODUCT_IDS=Weekly=pdt_xxx,Monthly=pdt_xxx,Lifetime=pdt_xxx

CRON_SECRET=change-me-to-a-long-random-string
